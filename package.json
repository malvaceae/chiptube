{
  "name": "chiptube",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "aws-blocks"
  ],
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "check": "concurrently npm:typecheck npm:lint npm:fmt:check",
    "dev": "tsx watch aws-blocks/scripts/server.ts",
    "sandbox": "tsx aws-blocks/scripts/sandbox.ts",
    "sandbox:destroy": "tsx aws-blocks/scripts/sandbox-destroy.ts",
    "sandbox:console": "tsx aws-blocks/scripts/console.ts",
    "cleanup": "tsx aws-blocks/scripts/cleanup.ts",
    "deploy": "tsx aws-blocks/scripts/deploy.ts",
    "destroy": "tsx aws-blocks/scripts/destroy.ts",
    "secret": "tsx aws-blocks/scripts/secret.ts",
    "typegen": "tsx aws-blocks/scripts/typegen.ts",
    "github": "tsx aws-blocks/scripts/github.ts",
    "build": "next build",
    "start": "next start",
    "prepare": "husky"
  },
  "dependencies": {
    "@aws-blocks/bb-distributed-data": "^0.1.7",
    "@aws-blocks/blocks": "^0.4.0",
    "@aws-blocks/hosting": "^0.2.0",
    "@base-ui/react": "^1.7.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "kysely": "^0.28.17",
    "lucide-react": "^1.39.0",
    "next": "^16.3.4",
    "next-themes": "^0.4.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@tsconfig/next": "^2.0.6",
    "@types/cross-spawn": "^6.0.6",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "aws-cdk-lib": "^2.267.0",
    "concurrently": "^10.0.5",
    "constructs": "^10.8.1",
    "cross-spawn": "^7.0.6",
    "esbuild": "^0.28.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.4.1",
    "oxfmt": "^0.66.0",
    "oxlint": "^1.81.0",
    "shadcn": "^4.20.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=24"
  }
}
